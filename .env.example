# Credentials used by the RabbitMQ container and the queues Spring Boot service.
# Change these values for your environment; do not commit real production secrets.
RABBITMQ_USER=cuidado_user
RABBITMQ_PASSWORD=cuidado_pass_change_me

# PDF FastAPI service URL.
# If FastAPI runs directly on this Windows host, use host.docker.internal from the container.
PDF_SERVICE_URL=http://127.0.0.1:8000

# Notification service URL used to send emails with PDF attachments.
NOTIFICATION_SERVICE_URL=http://host.docker.internal:8089
